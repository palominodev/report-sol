# Turso (libSQL) database credentials.
# Copy this file to .env.local and fill in the real values from your Turso dashboard.
# Never commit real credentials (.env* files are gitignored).
TURSO_URL=libsql://your-database-name.turso.io
TURSO_TOKEN=your-turso-auth-token

# Accounts: the session cookie is marked Secure in production, so serve the app over HTTPS there.
# Non-interactive use of `pnpm account ...` can read the password from this variable instead of
# prompting. Never commit a real value.
# ACCOUNT_PASSWORD=
